# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/ecommerce_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=username
DB_PASSWORD=password

# JWT Authentication
# SECURITY: Generate a strong random JWT secret and set via environment or secure secret management
# Example: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRES_IN=24h
# SECURITY: Generate a strong random refresh token secret
REFRESH_TOKEN_SECRET=

# Application Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000/api

# Session Configuration
# SECURITY: Generate a strong random session secret
SESSION_SECRET=
COOKIE_MAX_AGE=86400000

# Email Configuration (for user verification and notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@ecommerce.com

# Payment Gateway Configuration (Stripe example)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3001

# Redis Configuration (for session storage and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Third-party API Keys
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Admin Default Credentials (for initial setup)
# SECURITY: Set admin credentials through secure channels, not in committed files
# Use environment variables or secure secret management systems
ADMIN_EMAIL=admin@ecommerce.com
ADMIN_PASSWORD=